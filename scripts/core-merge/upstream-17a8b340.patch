+        expanded.init_buffer(vk::BufferUsageFlagBits::eIndexBuffer, vkutil::vma_mapped_alloc);
+        auto *destination = static_cast<uint8_t *>(expanded.mapped_data);
+        for (const auto &copy : copies)
