diff --git a/tools/autotests/conftest.py b/tools/autotests/conftest.py
new file mode 100644
index 00000000..94dc1154
--- /dev/null
+++ b/tools/autotests/conftest.py
@@ -0,0 +1,37 @@
+"""The command line options of test_autotests.py, checked before any test runs."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from suite import SUITE, find_tests, load_expectations
+
+
+def pytest_addoption(parser: pytest.Parser) -> None:
+    group = parser.getgroup("vita-autotests")
+    group.addoption("--checkout", type=Path, help="VitaAutotests checkout with its vpk built in build/")
+    group.addoption("--expectations", type=Path, help="file with the expected outcome of every test, all pass without one")
+    group.addoption("--autotest", action="append", default=[], metavar="NAME", help="a test to run, all of them by default, can be given more than once")
+
+
+def pytest_configure(config: pytest.Config) -> None:
+    # Here, so a bad option or expectations file stops the run with its message before any worker starts
+    if config.getoption("help"):
+        return
+    checkout = config.getoption("checkout")
+    if checkout is None:
+        raise pytest.UsageError("--checkout is needed, the VitaAutotests checkout with its vpk built in build/")
+    checkout = checkout.resolve()
+    tests = find_tests(checkout)
+    if not tests:
+        raise pytest.UsageError(f"{checkout} has no tests, no .expected files under tests/")
+    # Each test once, since two runs of one test would share its log
+    names = list(dict.fromkeys(config.getoption("autotest"))) or sorted(tests)
+    unknown = [name for name in names if name not in tests]
+    if unknown:
+        raise pytest.UsageError(f"not tests: {', '.join(unknown)}")
+    path = config.getoption("expectations")
+    expectations = load_expectations(path, tests) if path else dict.fromkeys(tests, ("pass", ""))
+    config.stash[SUITE] = (checkout, tests, {name: expectations[name] for name in names})
diff --git a/tools/autotests/expectations.txt b/tools/autotests/expectations.txt
new file mode 100644
index 00000000..78e1c5b3
--- /dev/null
+++ b/tools/autotests/expectations.txt
@@ -0,0 +1,725 @@
+# Expected outcome of each VitaAutotests test on Vita3K, with what each one that doesn't pass
+# catches: pass, fail (exits normally with other output), crash (Vita3K exits with an error),
+# timeout, or skip (not run, for a test whose outcome depends on how busy the host is). Every test
+# must be listed, and one that doesn't do what its line says fails the run.
+address_ranges                  pass
+affinity_mask_values            fail     # the CPU fields of thread info, threads ignore their core
+affinity_migrate                fail     # the CPU fields of thread info, threads ignore their core
+affinity_self_change_timing     fail     # threads ignore their core, so the core read after a mask change stays 0
+affinity_waiting_change         fail     # threads ignore their core, so a waiter whose mask changed runs on core 0
+affinity_widen                  fail     # threads are never READY or STANDBY and ignore their core
+app_free_sizes                  fail     # the app's code, data, stack and TLS aren't memory blocks, free sizes to the page
+app_memory_blocks               fail     # the app's code, data, stacks and TLS aren't memory blocks with their types
+app_memory_ranges               fail     # the app's own memory isn't in memory blocks, the find ignores its size
+appmgr_app_param_string         fail     # sceAppMgrAppParamGetString sizes, the NUL and the errors
+appmgr_system_event             crash    # sceAppMgrReceiveSystemEvent, then a host access past the guest's memory
+atomics                         pass
+audioout                        crash    # audio port size, rate and format checks, a NULL volume pointer
+cache_mount                     fail     # sceAppUtilCacheMount's init and mount checks, cache0: before a mount
+call_with_change_stack          fail     # a call that switches to a new stack doesn't run the function or return its value
+callback                        pass
+callback_after_wake             skip     # threads ignore their core and priority, so whether the woken thread ran before the notify is a race
+callback_after_wake_more        fail     # threads ignore their core and priority, so T runs on after the wake, its callback runs at the check or never, and the notify fails once T deleted it
+callback_cancel_departed        skip     # threads ignore their core and priority, so whether a notified callback runs before the cancel or delete is a race
+callback_cancel_flag            fail     # a cancel or delete of a pending callback clears the flag, the Vita keeps it
+callback_cancel_sets_waited_bits pass
+callback_changes                pass
+callback_clobbers_registers     pass
+callback_delete_in_run          fail     # a self delete in a callback check gives 0x800280A1 where the Vita gives 0
+callback_deleted_object         pass
+callback_edges                  pass
+callback_entry_state            fail     # a Thumb callback run by a check starts with the wrong r4 to r9 values
+callback_errors                 crash    # callback NULL argument errors, a NULL name
+callback_event_results          fail     # event calls don't take message pipe UIDs
+callback_event_waits            pass
+callback_info                   pass
+callback_info_fields            fail     # the notify ID of a callback is -1 and 0 swapped, fresh and inside a run
+callback_inner_nonobject_waits  pass
+callback_inner_same_object      pass
+callback_inner_same_pipe        pass
+callback_inner_wait             pass
+callback_limit                  fail     # no callback limit, Vita3K makes 4096 where the Vita stops at 2027 with an error
+callback_names                  fail     # a callback with a function at 0x1000 is created, the Vita refuses it
+callback_nesting                fail     # callbacks don't run inside callbacks
+callback_notify_burst           fail     # a callback notified many times before it runs counts fewer notifies
+callback_notify_cross_core      fail     # threads ignore their core and priority, so a notified thread above the spinner doesn't stop it
+callback_notify_departure_more  pass
+callback_notify_departure_state skip     # threads ignore their core and priority, so whether the notified waiter already ran when the main thread looks is a race
+callback_notify_during_run      fail     # a callback's notify ID reads -1 before the notifies, the Vita reads 0
+callback_notify_equal_priority  skip     # threads ignore their core and priority, so whether a notify switches to the waiter is a race
+callback_notify_preempt         skip     # threads ignore their core and priority, so whether the callback runs inside the notify is a race
+callback_notify_then_release    skip     # threads ignore their core and priority, so whether the notified waiter runs before the release is a race
+callback_notify_then_release_more skip     # a notified waiter leaves the queue only when its thread runs, so whether the object still counts it right after the notify is a race
+callback_notify_time_left       fail     # threads ignore their core and priority, so the waiter runs its callback during the notifier's busy interval and waits again
+callback_notify_time_left_more  fail     # after a callback notify the time left is the one when the wait returns, not the one at the notify, and a simple event wait that takes its bits after a notify returns 0, not NOTIFY_CALLBACK
+callback_outer_timeout          pass
+callback_outer_wake             pass
+callback_outer_wake_kinds       pass
+callback_outer_wake_more        pass
+callback_outer_wake_send        pass
+callback_owner_end              pass
+callback_pass_order             fail     # callback UIDs don't follow the Vita's creation order, and a run's callbacks differ
+callback_priority_requeue       fail     # no requeue on a priority change
+callback_requeue_order          pass
+callback_retake                 pass
+callback_retake_more            pass
+callback_return_in_waits        pass
+callback_return_pass            pass
+callback_stack                  fail     # callbacks don't run inside callbacks
