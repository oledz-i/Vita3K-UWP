+
+    // move the 1-bit field from bit 15 to bit 0, the 5-bit fields keep their order
+    for (uint32_t i = 0; i < width * height; ++i)
+        dst[i] = static_cast<uint16_t>((src[i] << 1) | (src[i] >> 15));
+}
