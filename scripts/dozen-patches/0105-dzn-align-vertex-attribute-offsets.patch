From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oledz-i <x@x>
Date: Sat, 31 Oct 2026 13:00:00 -0400
Subject: [PATCH] dzn: read misaligned vertex attributes through a shifted
 alias slot

---

diff --git a/src/microsoft/vulkan/dzn_private.h b/src/microsoft/vulkan/dzn_private.h
--- a/src/microsoft/vulkan/dzn_private.h
+++ b/src/microsoft/vulkan/dzn_private.h
@@ -1001,6 +1001,16 @@
       unsigned count;
       uint32_t strides[MAX_VBS];
    } vb;
+   /* VITA3K: D3D12 wants each vertex element's offset aligned to the smaller
+    * of its size and 4 bytes; Vulkan doesn't (a 3x16-bit attribute right
+    * after another sits at offset 6). Such an element reads from an extra
+    * slot that is the same buffer started 1-3 bytes later. */
+   struct {
+      unsigned count;
+      uint8_t slot[MAX_VBS];
+      uint8_t src[MAX_VBS];
+      uint8_t delta[MAX_VBS];
+   } vb_alias;
 
    struct {
       bool triangle_fan;
diff --git a/src/microsoft/vulkan/dzn_pipeline.c b/src/microsoft/vulkan/dzn_pipeline.c
--- a/src/microsoft/vulkan/dzn_pipeline.c
+++ b/src/microsoft/vulkan/dzn_pipeline.c
@@ -1212,6 +1212,7 @@
    D3D12_INPUT_CLASSIFICATION slot_class[MAX_VBS];
 
    pipeline->vb.count = 0;
+   pipeline->vb_alias.count = 0;
    for (uint32_t i = 0; i < in_vi->vertexBindingDescriptionCount; i++) {
       const struct VkVertexInputBindingDescription *bdesc =
          &in_vi->pVertexBindingDescriptions[i];
@@ -1245,16 +1246,46 @@
       if (patched_format != attr->format)
          vi_conversions[attr->location] = vk_format_to_pipe_format(attr->format);
 
+      /* VITA3K: misaligned offsets made the console refuse the whole pipeline
+       * (E_INVALIDARG: Persona 4 Golden's text and rooms, effects in others);
+       * read them through an alias slot shifted so the offset is aligned. */
+      uint32_t slot = attr->binding, offset = attr->offset;
+      const uint32_t elem_size = vk_format_get_blocksize(patched_format);
+      const uint32_t align = elem_size >= 4 ? 4 : MAX2(elem_size, 1);
+      if (offset % align) {
+         const uint8_t delta = offset % 4;
+         int found = -1;
+         for (unsigned a = 0; a < pipeline->vb_alias.count; a++) {
+            if (pipeline->vb_alias.src[a] == attr->binding && pipeline->vb_alias.delta[a] == delta)
+               found = a;
+         }
+         if (found < 0 && pipeline->vb_alias.count < 8) {
+            found = pipeline->vb_alias.count++;
+            pipeline->vb_alias.slot[found] = (uint8_t)(MAX_VBS - 1 - found);
+            pipeline->vb_alias.src[found] = (uint8_t)attr->binding;
+            pipeline->vb_alias.delta[found] = delta;
+            slot_class[MAX_VBS - 1 - found] = slot_class[attr->binding];
+         }
+         if (found >= 0) {
+            slot = pipeline->vb_alias.slot[found];
+            offset -= delta;
+            static unsigned logged;
+            if (logged++ < 8)
+               mesa_logw("dzn: VITA3K: vertex attribute at offset %u (%u bytes) read through slot %u at %u",
+                         attr->offset, elem_size, slot, offset);
+         }
+      }
+
       /* nir_to_dxil() name all vertex inputs as TEXCOORDx */
       inputs[attr->location] = (D3D12_INPUT_ELEMENT_DESC) {
          .SemanticName = "TEXCOORD",
          .Format = dzn_buffer_get_dxgi_format(patched_format),
-         .InputSlot = attr->binding,
+         .InputSlot = slot,
          .InputSlotClass = slot_class[attr->binding],
          .InstanceDataStepRate =
             divisor ? divisor->divisor :
             slot_class[attr->binding] == D3D12_INPUT_CLASSIFICATION_PER_INSTANCE_DATA ? 1 : 0,
-         .AlignedByteOffset = attr->offset,
+         .AlignedByteOffset = offset,
       };
    }
 
diff --git a/src/microsoft/vulkan/dzn_cmd_buffer.c b/src/microsoft/vulkan/dzn_cmd_buffer.c
--- a/src/microsoft/vulkan/dzn_cmd_buffer.c
+++ b/src/microsoft/vulkan/dzn_cmd_buffer.c
@@ -3687,6 +3687,29 @@
 {
    unsigned start, end;
 
+   /* VITA3K: alias slots (see vb_alias) follow their source buffer. */
+   const struct dzn_pipeline *bound =
+      cmdbuf->state.bindpoint[VK_PIPELINE_BIND_POINT_GRAPHICS].pipeline;
+   if (bound) {
+      const struct dzn_graphics_pipeline *gfx = (const struct dzn_graphics_pipeline *)bound;
+      for (unsigned a = 0; a < gfx->vb_alias.count; a++) {
+         const unsigned src = gfx->vb_alias.src[a], slot = gfx->vb_alias.slot[a];
+         if (!BITSET_TEST(cmdbuf->state.vb.dirty, src) && !BITSET_TEST(cmdbuf->state.vb.dirty, slot))
+            continue;
+         D3D12_VERTEX_BUFFER_VIEW view = cmdbuf->state.vb.views[src];
+         const unsigned delta = gfx->vb_alias.delta[a];
+         if (view.SizeInBytes > delta) {
+            view.BufferLocation += delta;
+            view.SizeInBytes -= delta;
+         } else {
+            view.SizeInBytes = 0;
+         }
+         view.StrideInBytes = gfx->vb.strides[src];
+         cmdbuf->state.vb.views[slot] = view;
+         BITSET_SET(cmdbuf->state.vb.dirty, slot);
+      }
+   }
+
    BITSET_FOREACH_RANGE(start, end, cmdbuf->state.vb.dirty, MAX_VBS)
       ID3D12GraphicsCommandList1_IASetVertexBuffers((dzn_cmd_note(cmdbuf, "IASetVertexBuffers"), cmdbuf->cmdlist), start, end - start, &cmdbuf->state.vb.views[start]);
 
