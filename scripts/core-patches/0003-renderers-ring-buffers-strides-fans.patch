+void RingBuffer::wait_segment(std::size_t segment) {
+    GLsync &fence = segment_fences_[segment];
+    if (!fence)
+        return;
+    GLbitfield flags = GL_SYNC_FLUSH_COMMANDS_BIT;
+    for (;;) {
+        const GLenum result = glClientWaitSync(fence, flags, 2'000'000); // 2 ms slices
+        if (result == GL_ALREADY_SIGNALED || result == GL_CONDITION_SATISFIED)
+            break;
+        if (result == GL_WAIT_FAILED) {
+            LOG_ERROR("Ring buffer fence wait failed; finishing the GPU instead");
+            glFinish();
+            break;
+        }
+        flags = 0;
     }
+    glDeleteSync(fence);
+    fence = nullptr;
+}
