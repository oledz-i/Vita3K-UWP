  <Identity Name="oledz.Vita3KUWP.Dev" Publisher="CN=Vita3K-UWP-Development" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="19b18280-8d0b-4566-86f9-640822a81a36" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
